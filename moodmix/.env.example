# PostgreSQL Connection URL
DATABASE_URL=postgresql://postgres:password@localhost:5432/moodmix

# YouTube Data API v3 Key
YOUTUBE_API_KEY=your_youtube_api_key_here

# Maximum songs to ingest across all queries
SONG_LIMIT=5000

# Batch size per request (Max 50 for YouTube Data API)
BATCH_SIZE=50

# Ingestion delay in milliseconds between requests (prevents rate limiting)
REQUEST_DELAY_MS=200

# Logging Level (debug, info, warn, error)
LOG_LEVEL=info

